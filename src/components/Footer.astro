---
const shopLinks = [
    { href: '/shop', label: 'All Products' },
    { href: '/collections', label: 'Collections' },
    { href: '/shop?new=1', label: 'New Arrivals' },
    { href: '/shop?sale=1', label: 'Sale' }
]

const infoLinks = [
    { href: '/about', label: 'About Me' },
    { href: '/contact', label: 'Contact' },
    { href: '/faq', label: 'FAQ' },
    { href: '/shipping', label: 'Shipping' }
]

const year = new Date().getFullYear()
---

<footer>
    <!-- Main footer -->
    <div class="bg-pink text-white pt-16 pb-12 px-8">
        <div class="container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
            <!-- Brand -->
            <div class="lg:col-span-1">
                <a
                    href="/"
                    class="font-heading font-bold text-2xl text-white hover:text-white/90 transition-colors no-underline block mb-3">
                    May Garcia
                </a>
                <p class="text-white/80 text-sm leading-relaxed mb-5">
                    Contemporary art, illustrations and unique handmade pieces from Colombia.
                </p>

                <!-- Social -->
                <div class="flex gap-2">
                    {
                        [
                            {
                                label: 'Instagram',
                                href: 'https://instagram.com/maygarcia',
                                path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z'
                            },
                            {
                                label: 'TikTok',
                                href: 'https://tiktok.com/@maygarcia',
                                path: 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.89a8.25 8.25 0 004.84 1.55V7a4.85 4.85 0 01-1.07-.31z'
                            },
                            {
                                label: 'Pinterest',
                                href: 'https://pinterest.com/maygarcia',
                                path: 'M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z'
                            }
                        ].map(({ label, href, path }) => (
                            <a
                                href={href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={label}
                                class="w-9 h-9 rounded-full bg-white/15 hover:bg-white/30 flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5 no-underline text-white">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d={path} />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Shop links -->
            <div>
                <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-4">Shop</h3>
                <ul class="list-none m-0 p-0 flex flex-col gap-2">
                    {
                        shopLinks.map(({ href, label }) => (
                            <li>
                                <a
                                    href={href}
                                    class="text-white/75 hover:text-white text-sm transition-colors no-underline">
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Info links -->
            <div>
                <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-4">Information</h3>
                <ul class="list-none m-0 p-0 flex flex-col gap-2">
                    {
                        infoLinks.map(({ href, label }) => (
                            <li>
                                <a
                                    href={href}
                                    class="text-white/75 hover:text-white text-sm transition-colors no-underline">
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Contact -->
            <div>
                <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-4">Contact</h3>
                <ul class="list-none m-0 p-0 flex flex-col gap-3">
                    {
                        [
                            { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', text: 'Mon–Sun 9:00–17:00' },
                            {
                                icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z|M22,6 12,13 2,6',
                                text: 'hello@maygarcia.co',
                                href: 'mailto:hello@maygarcia.co'
                            },
                            {
                                icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z|M12,10m-3,0a3,3 0 1,0 6,0a3,3 0 1,0 -6,0',
                                text: 'Colombia'
                            }
                        ].map(({ icon, text, href }) => (
                            <li class="flex items-start gap-2.5 text-sm text-white/75">
                                <svg
                                    class="w-4 h-4 flex-shrink-0 mt-0.5 text-white/60"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    {icon.split('|').map(d => (
                                        <path d={d} />
                                    ))}
                                </svg>
                                {href ?
                                    <a href={href} class="hover:text-white transition-colors no-underline">
                                        {text}
                                    </a>
                                :   <span>{text}</span>}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Bottom bar -->
    <div class="bg-neutral-900 py-4 px-8">
        <div class="container flex flex-col sm:flex-row items-center justify-between gap-3 flex-wrap">
            <p class="text-neutral-500 text-xs">&copy; {year} May Garcia. All rights reserved.</p>
            <div class="flex gap-5">
                {
                    [
                        { href: '/privacy', label: 'Privacy' },
                        { href: '/terms', label: 'Terms' },
                        { href: '/cookies', label: 'Cookies' }
                    ].map(({ href, label }) => (
                        <a href={href} class="text-neutral-500 hover:text-white text-xs transition-colors no-underline">
                            {label}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</footer>
