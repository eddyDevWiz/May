---
import CartCount from './react/CartCount'
import { getLang, switchLangUrl, useTranslations } from '../i18n/utils'

const lang = getLang(Astro.url)
const t    = useTranslations(lang)

const navLinks = [
    { href: lang === 'en' ? '/en/'            : '/',            label: t.nav.home },
    { href: lang === 'en' ? '/en/shop'        : '/shop',        label: t.nav.shop },
    { href: lang === 'en' ? '/en/collections' : '/collections', label: t.nav.collections },
    { href: lang === 'en' ? '/en/about'       : '/about',       label: t.nav.about },
    { href: lang === 'en' ? '/en/contact'     : '/contact',     label: t.nav.contact },
]

const otherLang = lang === 'es' ? 'en' : 'es'
const otherUrl  = switchLangUrl(Astro.url, otherLang)
const otherLabel = lang === 'es' ? 'EN' : 'ES'
---

<header
    id="site-header"
    class="sticky top-0 z-[900] px-8 bg-white/[0.97] backdrop-blur-md border-b border-neutral-100 transition-shadow duration-300">
    <div class="container flex items-center gap-8 h-[72px]">
        <!-- Logo -->
        <a
            href={lang === 'en' ? '/en/' : '/'}
            class="flex-shrink-0 flex items-center"
            aria-label="May Garcia - Home">
            <img
                src="/images/Logo_Mesa-de-trabajo-1-copia-2-3-e1733774355594.png"
                alt="May Garcia"
                class="h-14 w-auto"
            />
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden lg:flex flex-1 justify-center" aria-label="Main navigation">
            <ul class="flex items-center gap-1 list-none m-0 p-0">
                {
                    navLinks.map(({ href, label }) => (
                        <li>
                            <a
                                href={href}
                                class="block px-3.5 py-2 text-sm font-medium text-neutral-700 rounded-lg hover:text-pink hover:bg-pink-bg transition-all duration-200 no-underline">
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <!-- Actions -->
        <div class="flex-shrink-0 flex items-center gap-1 ml-auto">
            <!-- Language switcher -->
            <a
                href={otherUrl}
                class="w-10 h-10 flex items-center justify-center rounded-lg text-xs font-bold text-neutral-600 hover:bg-neutral-100 hover:text-pink transition-colors"
                aria-label={`Switch to ${otherLang}`}>
                {otherLabel}
            </a>

            <!-- Search -->
            <button
                id="search-toggle"
                class="w-10 h-10 flex items-center justify-center rounded-lg text-neutral-600 hover:bg-neutral-100 hover:text-pink transition-colors"
                aria-label="Search">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
                </svg>
            </button>

            <!-- Cart -->
            <button
                id="cart-btn"
                class="relative w-10 h-10 flex items-center justify-center rounded-lg text-neutral-600 hover:bg-neutral-100 hover:text-pink transition-colors"
                aria-label="Shopping cart">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <CartCount client:load />
            </button>

            <!-- Mobile toggle -->
            <button
                id="mobile-toggle"
                class="lg:hidden w-10 h-10 flex items-center justify-center rounded-lg text-neutral-600 hover:bg-neutral-100 transition-colors"
                aria-label="Menu"
                aria-expanded="false">
                <svg
                    id="icon-menu"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                <svg
                    id="icon-close"
                    class="hidden"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Nav -->
    <nav
        id="mobile-nav"
        class="lg:hidden overflow-hidden transition-all duration-300 border-t border-neutral-100"
        style="max-height: 0"
        aria-hidden="true"
        aria-label="Mobile navigation">
        <ul class="list-none m-0 px-6 py-3 flex flex-col">
            {
                navLinks.map(({ href, label }) => (
                    <li>
                        <a
                            href={href}
                            class="block py-3 text-base font-medium text-neutral-700 border-b border-neutral-100 hover:text-pink transition-colors no-underline last:border-none">
                            {label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    <!-- Search Bar -->
    <div
        id="search-bar"
        class="overflow-hidden transition-all duration-300 bg-neutral-50 border-t border-transparent"
        style="max-height: 0"
        aria-hidden="true">
        <div class="container py-3">
            <form action="/search" method="get" class="flex items-center gap-3">
                <input
                    type="search"
                    name="q"
                    placeholder="Search artwork..."
                    aria-label="Search products"
                    autocomplete="off"
                    class="flex-1 border-2 border-neutral-200 rounded-lg px-4 py-2.5 text-sm bg-white outline-none focus:border-pink transition-colors"
                />
                <button
                    type="submit"
                    class="w-10 h-10 bg-pink text-white rounded-lg flex items-center justify-center hover:bg-pink-dark transition-colors flex-shrink-0"
                    aria-label="Submit search">
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById('site-header')!
    const mobileToggle = document.getElementById('mobile-toggle')!
    const mobileNav = document.getElementById('mobile-nav')!
    const searchToggle = document.getElementById('search-toggle')!
    const searchBar = document.getElementById('search-bar')!
    const iconMenu = document.getElementById('icon-menu')!
    const iconClose = document.getElementById('icon-close')!

    window.addEventListener(
        'scroll',
        () => {
            header.classList.toggle('shadow-md', window.scrollY > 8)
        },
        { passive: true }
    )

    mobileToggle.addEventListener('click', () => {
        const isOpen = mobileNav.style.maxHeight !== '0px' && mobileNav.style.maxHeight !== ''
        mobileNav.style.maxHeight = isOpen ? '0px' : '400px'
        mobileNav.setAttribute('aria-hidden', String(isOpen))
        mobileToggle.setAttribute('aria-expanded', String(!isOpen))
        iconMenu.classList.toggle('hidden', !isOpen)
        iconClose.classList.toggle('hidden', isOpen)
    })

    searchToggle.addEventListener('click', () => {
        const isOpen = searchBar.style.maxHeight !== '0px' && searchBar.style.maxHeight !== ''
        searchBar.style.maxHeight = isOpen ? '0px' : '80px'
        searchBar.setAttribute('aria-hidden', String(isOpen))
        if (!isOpen) (searchBar.querySelector('input') as HTMLInputElement)?.focus()
    })

    document.getElementById('cart-btn')?.addEventListener('click', () => {
        window.dispatchEvent(new Event('cart:open'))
    })

    // Highlight active nav link
    const normalize = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p)
    const currentPath = normalize(window.location.pathname)
    const homePaths = ['/', '/en']
    document.querySelectorAll('nav a[href]').forEach(link => {
        const href = normalize(link.getAttribute('href')!)
        const isHome = homePaths.includes(href)
        if (href === currentPath || (!isHome && currentPath.startsWith(href + '/'))) {
            link.classList.add('text-pink', 'bg-pink-bg')
        }
    })
</script>
