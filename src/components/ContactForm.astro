---
import { useTranslations } from '../i18n/utils'
import type { Lang } from '../i18n/utils'

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props
const t = useTranslations(lang)

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
---

<div class="bg-white rounded-3xl p-8 shadow-card border border-neutral-100">
    <form
        id="contact-form"
        novalidate
        class="flex flex-col gap-5"
        data-sending={t.contact.sending}
        data-submit={t.contact.submit}
        data-error={t.contact.error}
        data-captcha={t.contact.captcha}>
        <!-- Honeypot: hidden from people, bots fill it -->
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
                <label for="name" class="text-sm font-semibold text-neutral-700">{t.contact.nameLabel}</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder={t.contact.namePlaceholder}
                    required
                    autocomplete="name"
                    class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 outline-none focus:border-pink transition-colors"
                />
            </div>
            <div class="flex flex-col gap-1.5">
                <label for="email" class="text-sm font-semibold text-neutral-700">{t.contact.emailLabel}</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder={t.contact.emailPlaceholder}
                    required
                    autocomplete="email"
                    class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 outline-none focus:border-pink transition-colors"
                />
            </div>
        </div>

        <div class="flex flex-col gap-1.5">
            <label for="subject" class="text-sm font-semibold text-neutral-700">{t.contact.subjectLabel}</label>
            <select
                id="subject"
                name="subject"
                required
                class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 bg-white outline-none focus:border-pink cursor-pointer transition-colors">
                <option value="">{t.contact.subjectPlaceholder}</option>
                <option value="commission">{t.contact.subjectCommission}</option>
                <option value="shipping">{t.contact.subjectShipping}</option>
                <option value="wholesale">{t.contact.subjectWholesale}</option>
                <option value="collab">{t.contact.subjectCollab}</option>
                <option value="other">{t.contact.subjectOther}</option>
            </select>
        </div>

        <div class="flex flex-col gap-1.5">
            <label for="message" class="text-sm font-semibold text-neutral-700">{t.contact.messageLabel}</label>
            <textarea
                id="message"
                name="message"
                rows={5}
                placeholder={t.contact.messagePlaceholder}
                required
                class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 outline-none focus:border-pink resize-y transition-colors"
            ></textarea>
        </div>

        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-language={lang}></div>}

        <button type="submit" class="btn btn-primary btn-lg w-full justify-center">{t.contact.submit}</button>

        <p class="text-xs text-neutral-400 text-center">{t.contact.note}</p>

        <p id="form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm font-medium m-0"></p>

        <div
            id="form-success"
            class="hidden flex items-center gap-3 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm font-medium">
            <span class="text-xl">✓</span>
            <p class="m-0 text-green-700">{t.contact.success}</p>
        </div>
    </form>
</div>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement
    const success = document.getElementById('form-success')!
    const errorBox = document.getElementById('form-error')!

    const showError = (msg: string) => {
        errorBox.textContent = msg
        errorBox.classList.remove('hidden')
    }

    form.addEventListener('submit', async e => {
        e.preventDefault()
        errorBox.classList.add('hidden')

        const fields = Array.from(
            form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]')
        )
        let valid = true

        fields.forEach(f => {
            if (!f.value.trim()) {
                f.classList.add('border-red-400')
                valid = false
            } else {
                f.classList.remove('border-red-400')
            }
        })

        if (!valid) return

        const hasCaptcha = !!form.querySelector('.cf-turnstile')
        if (hasCaptcha && !form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value) {
            showError(form.dataset.captcha!)
            return
        }

        const btn = form.querySelector('button[type=submit]') as HTMLButtonElement
        btn.disabled = true
        btn.textContent = form.dataset.sending!

        try {
            const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) })
            const data = await res.json()
            if (!res.ok || !data.success) throw new Error(data.error)

            btn.style.display = 'none'
            success.classList.remove('hidden')
            success.classList.add('flex')
            form.reset()
        } catch {
            showError(form.dataset.error!)
            btn.disabled = false
            btn.textContent = form.dataset.submit!
            ;(window as any).turnstile?.reset()
        }
    })
</script>
