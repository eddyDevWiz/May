---
import { useTranslations } from '../i18n/utils'
import type { Lang } from '../i18n/utils'

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props
const t = useTranslations(lang)
---

<style>
  .scroll-indicator {
    animation: scrollDown 2s ease-in-out infinite;
  }
  @keyframes scrollDown {
    0%, 100% { transform: translateX(-50%) translateY(0px); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }
</style>

<section class="relative min-h-[calc(100vh-72px)] flex flex-col justify-center overflow-hidden bg-cream px-14">
    <!-- Background blobs -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute -top-40 -right-40 w-[500px] h-[500px] rounded-full bg-pink opacity-30 blur-[80px]"></div>
        <div class="absolute -bottom-28 -left-28 w-[350px] h-[350px] rounded-full bg-pink-light opacity-25 blur-[80px]">
        </div>
    </div>

    <div class="container relative z-10 grid grid-cols-1 lg:grid-cols-2 items-center gap-16 py-20">
        <!-- Text content -->
        <div class="animate-fade-up">
            <span
                class="inline-block bg-pink-bg text-pink text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full mb-6">
                {t.hero.badge}
            </span>

            <h1 class="text-5xl lg:text-6xl font-heading font-bold text-neutral-800 leading-[1.1] mb-5">
                {t.hero.title} <span class="text-pink">{t.hero.titleHighlight}</span>
            </h1>

            <p class="text-lg text-neutral-500 leading-relaxed max-w-md mb-8">
                {t.hero.bio}
            </p>

            <div class="flex gap-4 flex-wrap">
                <a href={lang === 'en' ? '/en/shop' : '/shop'} class="btn btn-primary btn-lg">{t.hero.cta_shop}</a>
                <a href={lang === 'en' ? '/en/about' : '/about'} class="btn btn-outline btn-lg">{t.hero.cta_about}</a>
            </div>
        </div>

        <!-- Image / placeholder -->
        <div class="flex justify-center animate-fade-up" style="animation-delay: 0.15s">
            <div class="relative w-full max-w-[420px]">
                <!-- Main frame -->
                <div
                    class="relative rounded-3xl overflow-hidden shadow-[0_24px_64px_rgba(255,70,145,0.2)] aspect-[4/5] bg-pink-bg">
                    <img
                        src="/images/DSC_0314.jpg"
                        alt="May García with one of her paintings"
                        width="420"
                        height="525"
                        class="w-full h-full object-cover"
                    />
                </div>

                <!-- Floating badge — top left -->
                <div
                    class="absolute top-[10%] -left-5 flex items-center gap-2 bg-white rounded-full px-4 py-2.5 shadow-hover text-sm font-semibold text-neutral-700 animate-float whitespace-nowrap">
                    <span>🎨</span><span>{t.hero.floatArt}</span>
                </div>

                <!-- Floating badge — bottom right -->
                <div
                    class="absolute bottom-[15%] -right-5 flex items-center gap-2 bg-white rounded-full px-4 py-2.5 shadow-hover text-sm font-semibold text-neutral-700 animate-float whitespace-nowrap"
                    style="animation-delay: 1.5s">
                    <span>🚚</span><span>{t.hero.floatShipping}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div
        class="scroll-indicator absolute bottom-8 left-1/2 hidden md:flex flex-col items-center gap-1.5 text-neutral-400 text-xs font-medium"
        aria-hidden="true">
        <span>{t.hero.scroll}</span>
        <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </div>
</section>
