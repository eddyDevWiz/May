---
---

<!-- Overlay -->
<div id="cart-overlay" class="cart-overlay" aria-hidden="true"></div>

<!-- Cart Drawer -->
<aside id="cart-drawer" class="cart-drawer" aria-label="Carrito de compras" aria-hidden="true">
  <!-- Header -->
  <div class="cart-header">
    <h2>Mi Carrito</h2>
    <button id="cart-close-btn" class="cart-close" aria-label="Cerrar carrito">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Cart Items -->
  <div class="cart-items" id="cart-items">
    <!-- Populated by JS -->
    <div class="cart-empty" id="cart-empty">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <p>Tu carrito está vacío</p>
      <a href="/productos" class="btn btn-primary" onclick="closeCart()">Ver Productos</a>
    </div>
  </div>

  <!-- Footer -->
  <div class="cart-footer" id="cart-footer" style="display:none">
    <div class="cart-total">
      <span>Total</span>
      <span id="cart-total-price">$0</span>
    </div>
    <p class="cart-note">Impuestos y envío calculados al finalizar la compra.</p>
    <a id="checkout-btn" href="#" class="btn btn-primary btn-lg" style="width:100%; justify-content:center">
      Finalizar Compra
    </a>
    <button class="btn btn-outline" style="width:100%; justify-content:center; margin-top: 0.75rem" onclick="closeCart()">
      Seguir Comprando
    </button>
  </div>
</aside>

<style>
  /* Overlay */
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .cart-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  /* Drawer */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 420px;
    max-width: 100vw;
    height: 100dvh;
    background: #fff;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.12);
  }

  .cart-drawer.open {
    transform: translateX(0);
  }

  /* Header */
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .cart-header h2 {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .cart-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: var(--bg-cream);
    border-radius: var(--radius);
    cursor: pointer;
    color: var(--text);
    transition: all var(--transition);
  }

  .cart-close:hover {
    background: var(--pink-bg);
    color: var(--pink);
  }

  /* Items */
  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem;
  }

  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 1rem;
    color: var(--text-muted);
    text-align: center;
  }

  .cart-empty svg { opacity: 0.4; }
  .cart-empty p { font-size: 1rem; font-weight: 500; color: var(--text-light); }

  /* Cart Item */
  .cart-item {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .cart-item:last-child { border-bottom: none; }

  .cart-item-img {
    width: 72px;
    height: 72px;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
    background: var(--bg-cream);
  }

  .cart-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-info { flex: 1; min-width: 0; }

  .cart-item-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-item-variant {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.625rem;
  }

  .cart-item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-item-price {
    font-weight: 700;
    color: var(--pink);
    font-size: 0.9375rem;
  }

  .qty-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .qty-btn {
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 1rem;
    color: var(--text);
    transition: all var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qty-btn:hover { background: var(--pink-bg); color: var(--pink); }

  .qty-value {
    min-width: 24px;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .cart-item-remove {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.25rem;
    transition: color var(--transition);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .cart-item-remove:hover { color: #e53e3e; }

  /* Footer */
  .cart-footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--border);
    background: var(--bg-cream);
    flex-shrink: 0;
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    font-weight: 700;
    font-size: 1.0625rem;
  }

  #cart-total-price { color: var(--pink); }

  .cart-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-align: center;
  }

  @media (max-width: 440px) {
    .cart-drawer { width: 100vw; }
  }
</style>

<script>
  function renderCart() {
    const cart = (window as any).__cart;
    const itemsContainer = document.getElementById('cart-items')!;
    const emptyEl = document.getElementById('cart-empty')!;
    const footerEl = document.getElementById('cart-footer')!;
    const totalEl = document.getElementById('cart-total-price')!;
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLAnchorElement;

    if (!cart || cart.totalQuantity === 0) {
      itemsContainer.innerHTML = '';
      itemsContainer.appendChild(emptyEl);
      emptyEl.style.display = 'flex';
      footerEl.style.display = 'none';
      return;
    }

    emptyEl.style.display = 'none';
    footerEl.style.display = 'block';
    checkoutBtn.href = cart.checkoutUrl;

    const total = new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: cart.cost.totalAmount.currencyCode,
      minimumFractionDigits: 0,
    }).format(parseFloat(cart.cost.totalAmount.amount));
    totalEl.textContent = total;

    const lines = cart.lines.nodes;
    const html = lines.map((line: any) => {
      const img = line.merchandise.product.featuredImage;
      const price = new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: line.merchandise.price.currencyCode,
        minimumFractionDigits: 0,
      }).format(parseFloat(line.merchandise.price.amount) * line.quantity);

      return `
        <div class="cart-item" data-line-id="${line.id}">
          <div class="cart-item-img">
            ${img ? `<img src="${img.url}" alt="${img.altText ?? ''}" width="72" height="72" loading="lazy">` : ''}
          </div>
          <div class="cart-item-info">
            <p class="cart-item-title">${line.merchandise.product.title}</p>
            ${line.merchandise.title !== 'Default Title' ? `<p class="cart-item-variant">${line.merchandise.title}</p>` : ''}
            <div class="cart-item-footer">
              <span class="cart-item-price">${price}</span>
              <div class="qty-controls">
                <button class="qty-btn" data-line-id="${line.id}" data-action="decrease" aria-label="Disminuir cantidad">−</button>
                <span class="qty-value">${line.quantity}</span>
                <button class="qty-btn" data-line-id="${line.id}" data-action="increase" aria-label="Aumentar cantidad">+</button>
              </div>
            </div>
            <button class="cart-item-remove" data-line-id="${line.id}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              Eliminar
            </button>
          </div>
        </div>
      `;
    }).join('');

    // Keep empty el in DOM
    itemsContainer.innerHTML = html;
    itemsContainer.appendChild(emptyEl);

    // Qty & remove handlers
    itemsContainer.querySelectorAll('.qty-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const b = btn as HTMLButtonElement;
        const lineId = b.dataset.lineId!;
        const action = b.dataset.action!;
        const line = cart.lines.nodes.find((l: any) => l.id === lineId);
        if (!line) return;
        const qty = action === 'increase' ? line.quantity + 1 : Math.max(0, line.quantity - 1);
        await updateCartLine(lineId, qty);
      });
    });

    itemsContainer.querySelectorAll('.cart-item-remove').forEach(btn => {
      btn.addEventListener('click', async () => {
        const lineId = (btn as HTMLButtonElement).dataset.lineId!;
        await updateCartLine(lineId, 0);
      });
    });
  }

  async function updateCartLine(lineId: string, quantity: number) {
    const cart = (window as any).__cart;
    if (!cart) return;

    try {
      const res = await fetch('/api/cart/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cartId: cart.id, lineId, quantity }),
      });
      if (!res.ok) throw new Error();
      const data = await res.json();
      (window as any).__cart = data.cart;
      localStorage.setItem('mg_cart', JSON.stringify(data.cart));
      (window as any).updateCartCount?.();
      renderCart();
    } catch {
      (window as any).showToast?.('Error al actualizar el carrito');
    }
  }

  // Re-render when cart opens
  document.getElementById('site-header')?.querySelector('.cart-btn')?.addEventListener('click', renderCart);

  // Initial render if cart exists
  if ((window as any).__cart) renderCart();
</script>
