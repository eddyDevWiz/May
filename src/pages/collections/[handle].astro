---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollectionByHandle } from '../../lib/shopify';

export const prerender = false;

const { handle } = Astro.params;
if (!handle) return Astro.redirect('/collections');

const collection = await getCollectionByHandle(handle, 24);
if (!collection) return Astro.redirect('/collections');

const products = collection.products?.nodes ?? [];
---

<Layout
  title={`${collection.title} — May Garcia`}
  description={collection.description?.slice(0, 155) || `Explore the ${collection.title} collection by May Garcia.`}
  image={collection.image?.url}
>
  <div class="bg-gradient-to-br from-pink-bg to-white border-b border-neutral-100 py-12 text-center">
    <div class="container">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-neutral-800 mb-2">{collection.title}</h1>
      {collection.description && (
        <p class="text-neutral-500 max-w-xl mx-auto">{collection.description}</p>
      )}
    </div>
  </div>

  <section class="section flex justify-center">
    <div class="container">
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <a href="/collections" class="inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-pink">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          All collections
        </a>
        <p class="text-sm text-neutral-400">
          {products.length} {products.length === 1 ? 'product' : 'products'}
        </p>
      </div>

      {products.length > 0 ? (
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 lg:gap-7">
          {products.map(product => <ProductCard product={product} />)}
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center py-24 gap-4 text-center">
          <h2 class="text-xl font-heading font-bold text-neutral-700">No products in this collection yet</h2>
          <a href="/shop" class="btn btn-primary mt-2">Browse all products</a>
        </div>
      )}
    </div>
  </section>
</Layout>
