---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL, INSTAGRAM_URL, TIKTOK_URL, PINTEREST_URL } from '../lib/site'
---

<Layout
  title="Contacto — May Garcia"
  description="Contáctame para commissions, consultas sobre obra o envíos especiales."
>
  <div class="page-header">
    <div class="container">
      <h1>Contacto</h1>
      <p>Estoy aquí para ayudarte</p>
    </div>
  </div>

  <section class="section">
    <div class="container contact-layout">
      <!-- Info -->
      <div class="contact-info">
        <span class="eyebrow">Hablemos</span>
        <h2>¿Tienes alguna pregunta?</h2>
        <p>Ya sea para una pieza personalizada, una consulta sobre envíos o simplemente para charlar sobre arte, estoy disponible para ti.</p>

        <div class="contact-methods">
          <a href={`mailto:${CONTACT_EMAIL}`} class="contact-method">
            <div class="method-icon">📧</div>
            <div>
              <strong>Email</strong>
              <span>{CONTACT_EMAIL}</span>
            </div>
          </a>
          <a href="https://wa.me/573001234567" target="_blank" rel="noopener" class="contact-method">
            <div class="method-icon">💬</div>
            <div>
              <strong>WhatsApp</strong>
              <span>+57 300 123 4567</span>
            </div>
          </a>
          <div class="contact-method">
            <div class="method-icon">🕐</div>
            <div>
              <strong>Horario</strong>
              <span>Lun–Dom, 9:00–17:00</span>
            </div>
          </div>
          <div class="contact-method">
            <div class="method-icon">📍</div>
            <div>
              <strong>Ubicación</strong>
              <span>Colombia</span>
            </div>
          </div>
        </div>

        <div class="social-section">
          <p>Sígueme en redes sociales:</p>
          <div class="social-links">
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="social-link">Instagram</a>
            <a href={TIKTOK_URL} target="_blank" rel="noopener" class="social-link">TikTok</a>
            <a href={PINTEREST_URL} target="_blank" rel="noopener" class="social-link">Pinterest</a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrap">
        <form class="contact-form" id="contact-form" novalidate>
          <div class="form-group">
            <label for="name">Nombre completo *</label>
            <input type="text" id="name" name="name" placeholder="Tu nombre" required autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="email">Correo electrónico *</label>
            <input type="email" id="email" name="email" placeholder="tu@email.com" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="subject">Asunto *</label>
            <select id="subject" name="subject" required>
              <option value="">Selecciona un asunto</option>
              <option value="commission">Obra personalizada</option>
              <option value="shipping">Consulta de envío</option>
              <option value="wholesale">Venta al por mayor</option>
              <option value="collab">Colaboración</option>
              <option value="other">Otro</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Mensaje *</label>
            <textarea id="message" name="message" rows="5" placeholder="Cuéntame en qué te puedo ayudar..." required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg" style="width:100%">
            Enviar mensaje
          </button>

          <p class="form-note">* Respondo en menos de 24 horas en días hábiles.</p>

          <div id="form-success" class="form-success" aria-live="polite" style="display:none">
            <span>✓</span>
            <p>¡Mensaje enviado! Te responderé pronto.</p>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--pink-bg) 0%, #fff 100%);
    padding: 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .page-header p { color: var(--text-light); }

  /* Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 4rem;
    align-items: start;
  }

  /* Info */
  .contact-info .eyebrow {
    display: inline-block;
    color: var(--pink);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.875rem;
  }

  .contact-info h2 { margin-bottom: 1rem; }
  .contact-info > p { color: var(--text-light); margin-bottom: 2rem; }

  /* Contact Methods */
  .contact-methods { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-cream);
    border-radius: var(--radius-lg);
    transition: all var(--transition);
    text-decoration: none;
    color: inherit;
  }

  a.contact-method:hover {
    background: var(--pink-bg);
    transform: translateX(4px);
  }

  .method-icon { font-size: 1.5rem; flex-shrink: 0; }

  .contact-method div { display: flex; flex-direction: column; }
  .contact-method strong { font-size: 0.875rem; color: var(--text); }
  .contact-method span { font-size: 0.8125rem; color: var(--text-light); }

  /* Social */
  .social-section p { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  .social-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .social-link {
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--pink);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--pink);
    transition: all var(--transition);
  }

  .social-link:hover { background: var(--pink); color: #fff; }

  /* Form */
  .contact-form-wrap {
    background: #fff;
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
  }

  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }

  .form-group { display: flex; flex-direction: column; gap: 0.375rem; }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--text);
    background: #fff;
    transition: border-color var(--transition);
    resize: vertical;
    outline: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: var(--pink); }

  .form-group input.error,
  .form-group select.error,
  .form-group textarea.error { border-color: #e53e3e; }

  .form-note { font-size: 0.75rem; color: var(--text-muted); text-align: center; }

  .form-success {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: var(--radius);
    color: #166534;
    font-weight: 500;
    font-size: 0.9rem;
  }

  .form-success span { font-size: 1.25rem; }
  .form-success p { margin: 0; color: #166534; }

  /* Responsive */
  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successEl = document.getElementById('form-success')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const fields = form.querySelectorAll('input, select, textarea');
    let valid = true;

    fields.forEach(field => {
      const f = field as HTMLInputElement;
      f.classList.remove('error');
      if (f.required && !f.value.trim()) {
        f.classList.add('error');
        valid = false;
      }
    });

    if (!valid) {
      (window as any).showToast?.('Por favor completa todos los campos requeridos');
      return;
    }

    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Enviando...';

    // Simulate form submission (replace with real endpoint)
    await new Promise(r => setTimeout(r, 1200));

    btn.style.display = 'none';
    successEl.style.display = 'flex';
    form.reset();
  });
</script>
