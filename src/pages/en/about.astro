---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<Layout title="About — May Garcia" description="Meet May García, Colombian artist specializing in contemporary art and unique illustrations.">
    <div class="bg-gradient-to-br from-pink-bg to-white border-b border-neutral-100 py-12 text-center">
        <div class="container">
            <h1 class="text-3xl md:text-4xl font-heading font-bold text-neutral-800 mb-2">{t.nav.about}</h1>
            <p class="text-neutral-500">{t.about.tagline}</p>
        </div>
    </div>

    <section class="section">
        <div class="container grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div class="relative max-w-md mx-auto w-full">
                <div class="rounded-3xl overflow-hidden shadow-[0_24px_64px_rgba(255,70,145,0.18)]">
                    <div class="aspect-[4/5] bg-pink-bg">
                        <img src="/images/IMG_0133.jpg" alt="May García painting in her studio" width="400" height="500" class="w-full h-full object-cover" />
                    </div>
                </div>
                <div class="absolute -bottom-5 -right-3 flex items-center gap-3 bg-white rounded-2xl px-5 py-3.5 shadow-hover">
                    <span class="text-2xl">🎨</span>
                    <div class="flex flex-col">
                        <strong class="text-sm font-semibold text-neutral-800">May Garcia</strong>
                        <small class="text-xs text-neutral-400">{t.about.badge}</small>
                    </div>
                </div>
            </div>

            <div class="py-10">
                <span class="eyebrow mb-4 block">{t.about.eyebrow}</span>
                <h2 class="text-3xl md:text-4xl font-heading font-bold text-neutral-800 mb-6">{t.about.title}</h2>
                <p class="text-neutral-500 leading-relaxed mb-4">{t.about.p1}</p>
                <p class="text-neutral-500 leading-relaxed mb-8">{t.about.p2}</p>
                <div class="bg-cream rounded-2xl p-6 flex flex-col gap-5 mb-8">
                    {[
                        { icon: '🌺', title: t.about.val1Title, desc: t.about.val1Desc },
                        { icon: '💡', title: t.about.val2Title, desc: t.about.val2Desc },
                        { icon: '🤝', title: t.about.val3Title, desc: t.about.val3Desc },
                    ].map(({ icon, title, desc }) => (
                        <div class="flex items-start gap-4">
                            <span class="text-2xl flex-shrink-0 mt-0.5">{icon}</span>
                            <div>
                                <h4 class="font-heading text-sm font-semibold text-neutral-800 mb-1">{title}</h4>
                                <p class="text-sm text-neutral-500 leading-relaxed">{desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
                <div class="flex gap-4 flex-wrap">
                    <a href="/en/shop" class="btn btn-primary btn-lg">{t.about.cta_shop}</a>
                    <a href="/en/contact" class="btn btn-outline btn-lg">{t.about.cta_contact}</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
