---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductGallery from '../../../components/react/ProductGallery';
import VariantSelector from '../../../components/react/VariantSelector';
import AddToCart from '../../../components/react/AddToCart';
import { useTranslations } from '../../../i18n/utils';
import { getProductByHandle, getProducts, formatPrice } from '../../../lib/shopify';

export const prerender = false;

const lang = 'en' as const;
const t = useTranslations(lang);

const { handle } = Astro.params;
if (!handle) return Astro.redirect('/en/shop');

const [product, related] = await Promise.all([
  getProductByHandle(handle),
  getProducts(5),
]);

if (!product) return Astro.redirect('/en/shop');

const relatedProducts = related.filter(p => p.handle !== handle).slice(0, 4);

const minPrice = product.priceRange.minVariantPrice;
const maxPrice = product.priceRange.maxVariantPrice;
const displayPrice = formatPrice(minPrice.amount, minPrice.currencyCode);
const hasRange = minPrice.amount !== maxPrice.amount;
---

<Layout
  title={`${product.title} — May Garcia`}
  description={product.description.slice(0, 155)}
  image={product.featuredImage?.url}
>
  <div class="py-8 md:py-12">
    <div class="container">
      <!-- Back to shop -->
      <a href="/en/shop" class="inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-pink mb-8">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        {t.shop.backToShop}
      </a>

      <!-- Product layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

        <!-- Gallery (React — interactive thumbnails) -->
        <ProductGallery
          client:load
          images={product.images.nodes.length > 0 ? product.images.nodes : (product.featuredImage ? [product.featuredImage] : [])}
          title={product.title}
          available={product.availableForSale}
        />

        <!-- Product info -->
        <div class="lg:sticky lg:top-24">
          <!-- Title & price -->
          <h1 class="font-heading text-2xl md:text-3xl font-bold text-neutral-800 mb-3 leading-tight">
            {product.title}
          </h1>

          <div class="flex items-center gap-3 mb-3">
            <span class="font-heading text-2xl font-bold text-pink">
              {hasRange ? `${t.shop.fromPrice} ${displayPrice}` : displayPrice}
            </span>
            {!product.availableForSale && (
              <span class="badge bg-neutral-100 text-neutral-500 px-3 py-1 rounded-full text-xs font-bold">{t.shop.soldOut}</span>
            )}
          </div>

          <!-- Rating -->
          <div class="flex items-center gap-2 mb-6">
            <span class="text-amber-400 tracking-widest text-sm" aria-label="5 stars">★★★★★</span>
            <span class="text-xs text-neutral-400">(12 reviews)</span>
          </div>

          <!-- Variants (React — interactive) -->
          {product.variants.nodes.length > 1 && (
            <VariantSelector
              client:load
              variants={product.variants.nodes}
              onSelect={() => {}}
            />
          )}

          <!-- Description -->
          {product.descriptionHtml && (
            <div
              class="prose prose-sm max-w-none text-neutral-500 mb-6 pb-6 border-b border-neutral-100 leading-relaxed"
              set:html={product.descriptionHtml}
            />
          )}

          <!-- Add to cart (React — handles qty + cart API) -->
          <div class="mb-5">
            <AddToCart
              client:load
              variantId={product.variants.nodes[0]?.id ?? ''}
              productTitle={product.title}
              lang={lang}
              available={product.availableForSale}
            />
          </div>

          <!-- Tags -->
          {product.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-6">
              {product.tags.map(tag => (
                <span class="px-3 py-1 bg-neutral-100 border border-neutral-200 rounded-full text-xs text-neutral-500">{tag}</span>
              ))}
            </div>
          )}

          <!-- Shipping info -->
          <div class="rounded-2xl bg-cream p-5 flex flex-col gap-3">
            {[
              { icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12,10m-3,0a3,3 0 1,0 6,0a3,3 0 1,0 -6,0', label: t.shop.shipping },
              { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', label: t.shop.secure },
              { icon: 'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z', label: t.shop.packaging },
            ].map(({ icon, label }) => (
              <div class="flex items-center gap-3 text-sm text-neutral-500">
                <svg class="w-4 h-4 text-pink flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {icon.split(' ').map(d => <path d={d} />)}
                </svg>
                <span>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related products -->
  {relatedProducts.length > 0 && (
    <section class="section bg-cream">
      <div class="container">
        <div class="text-center mb-12">
          <span class="eyebrow">{t.shop.relatedEyebrow}</span>
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-neutral-800 mt-2">{t.shop.relatedTitle}</h2>
          <div class="divider"></div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5 lg:gap-7">
          {relatedProducts.map(p => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</Layout>
