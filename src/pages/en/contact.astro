---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { INSTAGRAM_URL, TIKTOK_URL, PINTEREST_URL } from '../../lib/site'
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<Layout title="Contact — May Garcia" description="Get in touch for commissions, shipping questions or custom artwork.">
    <div class="bg-gradient-to-br from-pink-bg to-white border-b border-neutral-100 py-12 text-center">
        <div class="container">
            <h1 class="text-3xl md:text-4xl font-heading font-bold text-neutral-800 mb-2">{t.contact.title}</h1>
            <p class="text-neutral-500">{t.contact.subtitle}</p>
        </div>
    </div>

    <section class="section px-8 py-5">
        <div class="container grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-16 items-start">
            <!-- Info -->
            <div>
                <span class="eyebrow mb-4 block">{t.contact.eyebrow}</span>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-neutral-800 mb-4">{t.contact.h2}</h2>
                <p class="text-neutral-500 leading-relaxed mb-8">{t.contact.p}</p>

                <div class="flex flex-col gap-3 mb-8">
                    {
                        [
                            {
                                icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z|M22 6l-10 7-10-7',
                                label: t.contact.email,
                                href: `mailto:${t.contact.email}`
                            },
                            {
                                icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z|M12,10m-3,0a3,3 0 1,0 6,0a3,3 0 1,0 -6,0',
                                label: t.contact.location,
                                href: undefined
                            },
                            {
                                icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
                                label: t.contact.hours,
                                href: undefined
                            }
                        ].map(({ icon, label, href }) => (
                            <div
                                class={`flex items-center gap-4 p-4 bg-cream rounded-xl transition-all duration-200 ${href ? 'hover:bg-pink-bg hover:translate-x-1 cursor-pointer' : ''}`}>
                                <div class="w-9 h-9 rounded-lg bg-pink/10 flex items-center justify-center flex-shrink-0">
                                    <svg
                                        class="w-4 h-4 text-pink"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round">
                                        {icon.split('|').map(d => (
                                            <path d={d} />
                                        ))}
                                    </svg>
                                </div>
                                {href ?
                                    <a
                                        href={href}
                                        class="text-sm font-medium text-neutral-700 hover:text-pink transition-colors no-underline">
                                        {label}
                                    </a>
                                :   <span class="text-sm font-medium text-neutral-700">{label}</span>}
                            </div>
                        ))
                    }
                </div>

                <!-- Social -->
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-3">{t.contact.followMe}</p>
                    <div class="flex gap-2">
                        {
                            [
                                { name: 'Instagram', href: INSTAGRAM_URL },
                                { name: 'TikTok', href: TIKTOK_URL },
                                { name: 'Pinterest', href: PINTEREST_URL }
                            ].map(({ name, href }) => (
                                <a
                                    href={href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="px-4 py-2 border-2 border-pink text-pink rounded-full text-xs font-bold hover:bg-pink hover:text-white transition-all duration-200 no-underline">
                                    {name}
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>

            <ContactForm lang="en" />
        </div>
    </section>
</Layout>

