---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Contact — May Garcia" description="Get in touch for commissions, shipping questions or custom artwork.">
    <div class="bg-gradient-to-br from-pink-bg to-white border-b border-neutral-100 py-12 text-center">
        <div class="container">
            <h1 class="text-3xl md:text-4xl font-heading font-bold text-neutral-800 mb-2">Contact</h1>
            <p class="text-neutral-500">I'm here to help</p>
        </div>
    </div>

    <section class="section px-8 py-5">
        <div class="container grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-16 items-start">
            <!-- Info -->
            <div>
                <span class="eyebrow mb-4 block">Let's talk</span>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-neutral-800 mb-4">Have a question?</h2>
                <p class="text-neutral-500 leading-relaxed mb-8">
                    Whether it's a custom piece, a shipping query or just to chat about art — I'm available for you.
                </p>

                <div class="flex flex-col gap-3 mb-8">
                    {
                        [
                            {
                                icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z|M22 6l-10 7-10-7',
                                label: 'hello@maygarcia.co',
                                href: 'mailto:hello@maygarcia.co'
                            },
                            {
                                icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z|M12,10m-3,0a3,3 0 1,0 6,0a3,3 0 1,0 -6,0',
                                label: 'Colombia',
                                href: undefined
                            },
                            {
                                icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
                                label: 'Mon–Sun 9:00–17:00',
                                href: undefined
                            }
                        ].map(({ icon, label, href }) => (
                            <div
                                class={`flex items-center gap-4 p-4 bg-cream rounded-xl transition-all duration-200 ${href ? 'hover:bg-pink-bg hover:translate-x-1 cursor-pointer' : ''}`}>
                                <div class="w-9 h-9 rounded-lg bg-pink/10 flex items-center justify-center flex-shrink-0">
                                    <svg
                                        class="w-4 h-4 text-pink"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round">
                                        {icon.split('|').map(d => (
                                            <path d={d} />
                                        ))}
                                    </svg>
                                </div>
                                {href ?
                                    <a
                                        href={href}
                                        class="text-sm font-medium text-neutral-700 hover:text-pink transition-colors no-underline">
                                        {label}
                                    </a>
                                :   <span class="text-sm font-medium text-neutral-700">{label}</span>}
                            </div>
                        ))
                    }
                </div>

                <!-- Social -->
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-3">Follow me</p>
                    <div class="flex gap-2">
                        {
                            ['Instagram', 'TikTok', 'Pinterest'].map(name => (
                                <a
                                    href={`https://${name.toLowerCase()}.com/maygarcia`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="px-4 py-2 border-2 border-pink text-pink rounded-full text-xs font-bold hover:bg-pink hover:text-white transition-all duration-200 no-underline">
                                    {name}
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Form -->
            <div class="bg-white rounded-3xl p-8 shadow-card border border-neutral-100">
                <form id="contact-form" novalidate class="flex flex-col gap-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label for="name" class="text-sm font-semibold text-neutral-700">Full name *</label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Your name"
                                required
                                autocomplete="name"
                                class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 outline-none focus:border-pink transition-colors"
                            />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label for="email" class="text-sm font-semibold text-neutral-700">Email *</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@email.com"
                                required
                                autocomplete="email"
                                class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 outline-none focus:border-pink transition-colors"
                            />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="subject" class="text-sm font-semibold text-neutral-700">Subject *</label>
                        <select
                            id="subject"
                            name="subject"
                            required
                            class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 bg-white outline-none focus:border-pink cursor-pointer transition-colors">
                            <option value="">Select a subject</option>
                            <option value="commission">Custom artwork</option>
                            <option value="shipping">Shipping enquiry</option>
                            <option value="wholesale">Wholesale</option>
                            <option value="collab">Collaboration</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="message" class="text-sm font-semibold text-neutral-700">Message *</label>
                        <textarea
                            id="message"
                            name="message"
                            rows={5}
                            placeholder="Tell me how I can help..."
                            required
                            class="border-2 border-neutral-200 rounded-lg px-4 py-3 text-sm text-neutral-800 outline-none focus:border-pink resize-y transition-colors"
                        ></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-full justify-center"> Send Message </button>

                    <p class="text-xs text-neutral-400 text-center">* I reply within 24 hours on business days.</p>

                    <div
                        id="form-success"
                        class="hidden flex items-center gap-3 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm font-medium">
                        <span class="text-xl">✓</span>
                        <p class="m-0 text-green-700">Message sent! I'll get back to you soon.</p>
                    </div>
                </form>
            </div>
        </div>
    </section>
</Layout>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement
    const success = document.getElementById('form-success')!

    form.addEventListener('submit', async e => {
        e.preventDefault()

        const fields = Array.from(
            form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]')
        )
        let valid = true

        fields.forEach(f => {
            if (!f.value.trim()) {
                f.classList.add('border-red-400')
                valid = false
            } else {
                f.classList.remove('border-red-400')
            }
        })

        if (!valid) return

        const btn = form.querySelector('button[type=submit]') as HTMLButtonElement
        btn.disabled = true
        btn.textContent = 'Sending…'

        await new Promise(r => setTimeout(r, 1200))

        btn.style.display = 'none'
        success.classList.remove('hidden')
        success.classList.add('flex')
        form.reset()
    })
</script>
